# Normalize line endings on commit
*           text=auto eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf

# Binaries — no conversion
*.woff2     binary
*.woff      binary
*.ttf       binary
*.eot       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.webp      binary
