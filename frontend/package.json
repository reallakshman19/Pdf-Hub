    "check:all": "npm run typecheck && npm run audit:no-mojibake && npm run test:ci && npm run check:static",
    "check:release": "npm run typecheck && npm run audit:no-mojibake && npm run lint && npm run test:ci && npm run check:doc-hub && npm run check:static && npm run build"
