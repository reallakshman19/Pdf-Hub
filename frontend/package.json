{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit:no-mojibake": "node scripts/no-mojibake-audit.mjs",
    "audit:phase8": "node scripts/phase8-static-audit.mjs",
    "certify": "npm run typecheck && vitest run && node scripts/phase8-static-audit.mjs && tsc -b && vite build",
    "audit:no-placeholders": "node scripts/no-placeholder-audit.mjs",
    "audit:contracts": "node scripts/contract-duplicate-audit.mjs",
    "certify:slice1": "npm run typecheck && npm run audit:no-placeholders && npm run audit:contracts && npm run build",
    "audit:macro-enh2-placeholders": "node scripts/macro-enh2-active-placeholder-audit.mjs",
    "certify:macro-enh2": "node scripts/macro-enh2-certify.mjs",
    "audit:writer-overlay-v2-boundary": "node scripts/writer-v2-boundary-audit.mjs",
    "certify:writer-overlay-v2": "node scripts/certify-writer-overlay-v2.mjs",
    "certify:writer-overlay-v2-final": "node scripts/final-certify-writer-overlay-v2.mjs",
    "certify:generate-document": "node scripts/certify-generate-document.mjs",
    "certify:writer-v2-docx": "node scripts/certify-writer-v2-docx.mjs",
    "certify:writer-table-pro": "node scripts/certify-writer-table-pro.mjs",
    "certify:writer-blank-doc": "vitest run src/core/writer-v2/__tests__/writerDocumentMode.test.ts src/core/writer-v2/__tests__/writerV2StoreBlankDocument.test.ts src/core/writer-v2/__tests__/writerBlankDocumentLayout.test.ts src/components/writer-v2/__tests__/WriterBlankPageCanvas.test.tsx src/components/writer-v2/__tests__/BlankDocumentCreateDialog.test.tsx src/components/writer-v2/WriterV2ToolbarControls.test.tsx --pool=forks --maxWorkers=1",
    "certify:layout-engine": "vitest run src/core/macro/layout/LayoutEngine.test.ts",
    "certify:generation-recipes": "vitest run src/core/macro/generateDocument/generationRecipes.test.ts",
    "certify:generation-template-library": "vitest run src/core/macro/generateDocument/generationRecipes.test.ts src/core/macro/generateDocument/templateLibraryValidation.test.ts src/core/macro/generateDocument/buildGenerationRecipe.test.ts src/components/sidebar/MacrosSidebar.generateDocument.test.tsx",
    "check:static": "node scripts/static-contract-checks.mjs",
    "check:all": "npm run typecheck && npm run audit:no-mojibake && npm run test:ci && npm run check:static",
    "check:release": "npm run typecheck && npm run audit:no-mojibake && npm run lint && npm run test:ci && npm run certify:writer-v2-docx && npm run certify:writer-table-pro && npm run check:static && npm run build"
  },
  "dependencies": {
    "@lexical/code": "0.44.0",
    "@lexical/history": "0.44.0",
    "@lexical/html": "0.44.0",
    "@lexical/link": "0.44.0",
    "@lexical/list": "0.44.0",
    "@lexical/react": "0.44.0",
    "@lexical/rich-text": "0.44.0",
    "@lexical/selection": "0.44.0",
    "@lexical/table": "0.44.0",
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "konva": "^10.2.5",
    "lexical": "0.44.0",
    "lucide-react": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "react-resizable-panels": "^4.10.0",
    "react-router-dom": "^7.14.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "virtua": "^0.49.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
