  "subtype_ambiguities": {
    "Text": {
      "candidate_types": [
        "comment",
        "sticky-note"
      ],
      "primary_distinction": "Review reply/state IRT topology vs standalone sticky note; root-level StateModel is accepted only for legacy compatibility",
      "oracle_rule": "If the Text root participates in review reply/state IRT topology, classify as comment; otherwise classify as sticky-note unless legacy StateModel/custom metadata proves comment semantics"
    },
    "Square": {
      "candidate_types": [
        "shape-rect",
        "shape-cloud",
        "redaction"
      ],
      "primary_distinction": "BE (Border Effect) for cloud, solid black fill/stroke mask for redaction, standard stroke/fill for shape-rect",
      "oracle_rule": "If BE is present with /S /C -> shape-cloud; else if visual mask styling -> redaction; else shape-rect"
    },
    "Line": {
      "candidate_types": [
        "line",
        "arrow"
      ],
      "primary_distinction": "LE (Line Ending) array indicating arrowheads",
      "oracle_rule": "If LE contains OpenArrow or ClosedArrow -> arrow; else line"
    },
    "FreeText": {
      "candidate_types": [
        "textbox",
        "callout"
      ],
      "primary_distinction": "IT dictionary entry (/FreeTextCallout) and CL callout line coordinates",
      "oracle_rule": "If IT is FreeTextCallout or CL is defined -> callout; else textbox"
    }
  },
  "policies": {
    "appearance_stream_requirement": {
      "enforce_ap_for_all_supported_types": true,
      "rationale": "External viewers without dynamic appearance generation (Adobe Acrobat, Preview, third-party viewers) depend on explicit /AP streams to render annotations."
    },
    "external_edit_precedence": {
      "standard_fields_override_custom_data": true,
      "reader_enforced_fields": [
        "Contents",
        "Rect",
        "C",
        "IC",
        "CL",
        "L",
        "Vertices",
        "InkList",
        "State"
      ],
      "pending_fields": [
        "DA",
        "QuadPoints"
      ],
      "rationale": "Recognized standard PDF state is authoritative on re-import. Fields not yet represented by the production reader remain explicit pending limitations rather than implied support."
    },
    "save_vs_export_separation": {
      "save_preserves_native_annotations": true,
      "export_flattened_burns_into_page": true,
      "hidden_flattening_prohibited": true,
      "rationale": "Save/Save As must remain fully editable without destroying native /Annot dictionaries. Export Flattened permanently renders into page contents."
    },
    "signed_pdf_rewrite_policy": {
      "warn_on_rewrite": true,
      "prevent_false_validity_claims": true,
      "rationale": "Full document rewrite invalidates cryptographic signatures. Users must be warned explicitly."
    },
    "review_state_projection": {
      "native_model": "AUTHOR_SPECIFIC_CHAINED_STATE_TRANSITIONS",
      "application_model": "SINGLE_THREAD_STATUS",
      "projection_rule": "Project the latest observable Review transition by modification/creation timestamp with annotation order as a deterministic fallback.",
      "preservation_rule": "Preserve all native Review state transition annotations and their IRT chains. A PDF Hub save appends a transition only when the application review status differs semantically from the latest native Review state.",
      "limitation": "Parallel author-specific Review states are preserved in the PDF but are not yet surfaced as separate application statuses.",
      "transition_author": {
        "native_source": "State annotation T text string",
        "imported_projection": "ReviewMetadata.statusAuthor",
        "local_status_action_default": "Current User",
        "write_rule": "New Review state transitions use statusAuthor when known; thread author is only a fallback for legacy/imported metadata lacking transition-actor provenance.",
        "chain_rule": "A newly appended Review state transition points to the latest preserved state transition by the same statusAuthor, or to the review root when that author has no prior state."
      }
    }
  },
  "review_thread_fixture": {
    "root": {
      "type": "comment",
      "nm": "phase10-review-root-1",
      "initialContents": "Original review text",
      "initialReviewState": "resolved"
    },
    "reply": {
      "id": "phase10-review-reply-1",
      "relationship": "IRT_OBJECT_REFERENCE",
      "replyType": "R"
    },
    "repeated_save": {
      "cycles": 2,
      "identity_exact": [
        "root NM",
        "reply NM",
        "state NM"
      ],
      "relationship_exact": [
        "reply IRT",
        "state IRT"
      ],
      "duplicates_allowed": false,
      "state_history_preserved": true,
      "noop_save_appends_state": false,
      "semantic_state_change_appends_transition": true
    },
    "state": {
      "nm": "phase10-review-root-1:state:Review",
      "subtype": "Text",
      "relationship": "IRT_OBJECT_REFERENCE",
      "stateModel": "Review",
      "initialState": "Completed",
      "encoding": "TEXT_STRING",
      "transition_rule": "The first state annotation points to the review root. Additional state changes for the same author are appended in reply to that author's previous state annotation; existing native transition history is preserved."
    }
  }
}
